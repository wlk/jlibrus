# Copy to .env and fill in. Never commit .env.

# --- login to the jlibrus web app (single user, no sign-up) ---
APP_USERNAME=parent
APP_PASSWORD=change-me-to-a-long-password
# 32+ random characters keep sessions valid across restarts: openssl rand -base64 32
APP_SESSION_KEY=
# Default UI/e-mail language: pl or en
APP_LANGUAGE=pl

# --- Librus Synergia accounts: one per child (login like 1234567u or the parent login) ---
LIBRUS_ACCOUNT_1_LOGIN=
LIBRUS_ACCOUNT_1_PASSWORD=
# Optional display name instead of the name from Librus
LIBRUS_ACCOUNT_1_NAME=
#LIBRUS_ACCOUNT_2_LOGIN=
#LIBRUS_ACCOUNT_2_PASSWORD=
#LIBRUS_ACCOUNT_2_NAME=

# Demo mode only: talk to the bundled mock instead of Librus (use with --profile demo)
#LIBRUS_ENDPOINT_OVERRIDE=http://librus-mock:8090

# --- database: PostgreSQL by default in compose; for SQLite use DB_URL=jdbc:sqlite:/data/jlibrus.db ---
DB_URL=jdbc:postgresql://postgres:5432/jlibrus
DB_USERNAME=jlibrus
DB_PASSWORD=jlibrus

# --- SMTP for e-mail summaries (defaults deliver to the local Mailpit inbox) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=jlibrus@localhost
SMTP_USERNAME=
SMTP_PASSWORD=
# DISABLED | OPTIONAL | REQUIRED
SMTP_STARTTLS=DISABLED
SMTP_TLS=false

# --- schedules (Quartz cron, school time zone) ---
#SUMMARY_DAILY_CRON=0 0 18 * * ?
#SUMMARY_WEEKLY_CRON=0 0 18 ? * SUN
#SUMMARY_MONTHLY_CRON=0 0 18 L * ?
#SYNC_INTERVAL=15m
#APP_TIMEZONE=Europe/Warsaw
